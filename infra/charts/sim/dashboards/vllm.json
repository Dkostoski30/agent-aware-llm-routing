{
  "uid": "thesis-vllm",
  "title": "vLLM pods",
  "editable": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue length (requests waiting)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (vllm:num_requests_waiting)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "KV-cache usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (vllm:kv_cache_usage_perc)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prefix-cache hit rate (hit tokens / queried tokens)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(vllm:prefix_cache_hits_total[$__rate_interval])) / sum by (pod) (rate(vllm:prefix_cache_queries_total[$__rate_interval]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Remaining work (steps of active runs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(thesis_remaining_work)",
          "legendFormat": "remaining work"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache pressure (active runs' context over the ready pods' KV cache)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(thesis_context_tokens) / (count(kube_pod_status_ready{namespace=\"default\",pod=~\"vllm-[a-z0-9]+-[a-z0-9]+\",condition=\"true\"} == 1 unless on (pod) kube_pod_deletion_timestamp{namespace=\"default\",pod=~\"vllm-[a-z0-9]+-[a-z0-9]+\"}) * $kv_cache_tokens)",
          "legendFormat": "cache pressure"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "kv_cache_tokens",
        "label": "KV cache tokens per pod",
        "hide": 2,
        "query": ""
      }
    ]
  }
}
